{
  "name": "Kazhal-project",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "infra:up": "sh scripts/infra.sh up",
    "infra:ps": "sh scripts/infra.sh ps",
    "infra:logs": "sh scripts/infra.sh logs",
    "infra:stop": "sh scripts/infra.sh stop"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
