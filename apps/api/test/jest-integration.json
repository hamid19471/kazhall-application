{
  "rootDir": "..",
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testRegex": "test/integration/.*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "diagnostics": false
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1",
    "^uuid$": "<rootDir>/test/integration/setup/uuid-cjs-shim.ts"
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/test/integration/setup/global-setup.ts",
  "globalTeardown": "<rootDir>/test/integration/setup/global-teardown.ts",
  "testTimeout": 120000,
  "maxWorkers": 1,
  "forceExit": false,
  "detectOpenHandles": false,
  "verbose": true,
  "setupFilesAfterEnv": [
    "<rootDir>/test/integration/setup/diagnostics.setup.ts"
  ],
  "testSequencer": "<rootDir>/test/integration/setup/shuffle-sequencer.js"
}
