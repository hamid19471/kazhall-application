# Copy to `.env.production`, replace every placeholder, and keep that file out
# of Git. Compose uses it for interpolation; secrets are not image build args.

COMPOSE_PROJECT_NAME=kazhal-production

# Browser-visible origins embedded into Web and POS at build time.
PUBLIC_API_URL=https://api.example.com
PUBLIC_REALTIME_URL=https://api.example.com
WEB_ORIGIN=https://shop.example.com
POS_ORIGIN=https://pos.example.com
PAYMENT_CALLBACK_URL=https://shop.example.com/checkout/payment/return
S3_PUBLIC_BASE_URL=https://assets.example.com/kazhal-products

# Published host ports. Put a TLS reverse proxy/load balancer in front of them.
API_PORT=8000
WEB_PORT=8001
POS_PORT=8002
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Generate secrets with `openssl rand -hex 32`.
POSTGRES_DB=kazhal
POSTGRES_USER=kazhal
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
OTP_HMAC_SECRET=replace-with-openssl-rand-hex-32
MINIO_ROOT_USER=replace-with-a-random-access-key
MINIO_ROOT_PASSWORD=replace-with-a-long-random-secret
ZIBAL_MERCHANT=replace-with-your-production-zibal-merchant

# Optional one-time bootstrap account. Remove both values after first use.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

S3_BUCKET=kazhal-products
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
